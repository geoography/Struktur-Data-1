#include <iostream>
using namespace std;

int main() {
    int arr[3][3][4];
    int ret = 1;
    
    for (int i = 0; i < 3; i++){
        for (int j = 0; j < 3; j++){
            for (int k = 0; k < 4; k++){
                arr[i][j][k] = ret * 2;
                ret++;
            }
        }
    }
    
    for (int i = 0; i < 3; i++){
        for (int j = 0; j < 3; j++){
            for (int k = 0; k < 4; k++){
                cout << arr[i][j][k] << " ";
            }
            cout << endl;
        }
        cout << endl;
    }
    return 0;
}
